{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工作流观察",
  "version": "0.8.0",
  "identifier": "local.workflowmonitor.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "工作流观察",
        "url": "index.html",
        "width": 460,
        "height": 780,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
