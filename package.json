{
  "name": "three-workflow-monitor",
  "version": "0.5.0",
  "private": true,
  "description": "Local, traceable workflow progress plugin for Token Monitor",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node tools/build.cjs",
    "build:desktop": "node tools/build-desktop.cjs",
    "export:github": "node tools/export-github.cjs",
    "sample": "node tools/sample.cjs",
    "preview": "node tools/preview-control.cjs start --no-open",
    "preview:stop": "node tools/preview-control.cjs stop"
  },
  "engines": {"node": ">=22.12.0"},
  "devDependencies": {"electron": "45.2.1", "semver": "7.8.5"},
  "vendoredDependencies": {"fuse.js": {"version": "7.5.0", "file": "plugin/fuse.basic-7.5.0.min.mjs", "license": "Apache-2.0", "receipt": "vendor/fuse-7.5.0/receipt.json"}}
